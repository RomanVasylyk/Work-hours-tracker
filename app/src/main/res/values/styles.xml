<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.WorkTracker.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="iconTint">@color/onPrimary</item>
    </style>

    <style name="Widget.WorkTracker.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/job_card_stroke</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
    </style>

    <style name="Widget.WorkTracker.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primaryContainer</item>
        <item name="android:textColor">@color/onPrimaryContainer</item>
        <item name="iconTint">@color/onPrimaryContainer</item>
    </style>

    <style name="Widget.WorkTracker.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/field_surface</item>
        <item name="boxStrokeColor">@color/job_card_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/field_hint</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.WorkTracker.Field</item>
    </style>

    <style name="Widget.WorkTracker.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/field_surface_alt</item>
        <item name="boxStrokeColor">@color/job_card_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/field_hint</item>
        <item name="endIconTint">@color/primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.WorkTracker.Field</item>
    </style>

    <style name="Widget.WorkTracker.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/field_text</item>
        <item name="android:textColorHint">@color/field_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.WorkTracker.DropdownInput" parent="@style/Widget.WorkTracker.TextInputEditText">
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
        <item name="android:dropDownSelector">@drawable/bg_dropdown_option_item</item>
    </style>

    <style name="Widget.WorkTracker.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <style name="Widget.WorkTracker.SegmentedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/job_card_stroke</item>
    </style>

    <style name="ShapeAppearanceOverlay.WorkTracker.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="TextAppearance.WorkTracker.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/onSurface</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.WorkTracker.DialogBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/job_hint_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.WorkTracker.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
    </style>
</resources>
