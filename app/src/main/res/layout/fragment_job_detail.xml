<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/jobDetailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ui.JobDetailFragment">

    <LinearLayout
        android:id="@+id/jobDetailContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/job_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_job_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/primary"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    tools:text="Травень 2026" />

                <TextView
                    android:id="@+id/textJobName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxLines="2"
                    android:textColor="@color/onSurface"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    tools:text="Основна робота" />

                <TextView
                    android:id="@+id/textSalary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxLines="2"
                    android:textColor="@color/secondary"
                    style="@style/TextAppearance.Material3.HeadlineSmall"
                    tools:text="1500,00 €" />

                <TextView
                    android:id="@+id/textHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/onSurface"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    tools:text="150 hod" />

                <TextView
                    android:id="@+id/textHeroMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/chart_axis_text"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    tools:text="20 dní · 10,00 €/hod" />

                <LinearLayout
                    android:id="@+id/layoutHeroActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddEntry"
                        style="@style/Widget.WorkTracker.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minHeight="56dp"
                        android:text="@string/job_detail_add_entry" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonStats"
                        style="@style/Widget.WorkTracker.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minHeight="56dp"
                        android:text="@string/stat"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonInvoice"
                        style="@style/Widget.WorkTracker.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minHeight="56dp"
                        android:text="@string/create_invoice" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/job_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_panel"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/job_detail_period_title"
                    style="@style/TextAppearance.Material3.TitleMedium" />


                <LinearLayout
                    android:id="@+id/layoutJobFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutYearField"
                        style="@style/Widget.WorkTracker.TextInputLayout.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/stats_mode_year">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/inputYear"
                            style="@style/Widget.WorkTracker.DropdownInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutMonthField"
                        style="@style/Widget.WorkTracker.TextInputLayout.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/stats_mode_month">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/inputMonth"
                            style="@style/Widget.WorkTracker.DropdownInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/job_detail_shifts_title"
            style="@style/TextAppearance.Material3.TitleLarge" />


        <GridLayout
            android:id="@+id/gridPrimaryStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <TextView
                android:id="@+id/textDays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile"
                android:minHeight="92dp"
                android:padding="16dp"
                android:textColor="@color/onSurface"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Відпрацьовано днів: 20" />

            <TextView
                android:id="@+id/textMorning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Ранкових змін: 5" />

            <TextView
                android:id="@+id/textDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Денних змін: 9" />

            <TextView
                android:id="@+id/textNight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Нічних змін: 6" />

            <TextView
                android:id="@+id/textHolidays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Святкових днів: 2" />

            <TextView
                android:id="@+id/textSaturday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Субота: 3" />

            <TextView
                android:id="@+id/textSunday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Неділя: 2" />
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/job_detail_bonuses_title"
            style="@style/TextAppearance.Material3.TitleLarge" />

        <GridLayout
            android:id="@+id/gridBonusStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <TextView
                android:id="@+id/textNightBonus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile_bonus"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Доплата нічні: 140.00" />

            <TextView
                android:id="@+id/textSaturdayBonus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile_bonus"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Доплата субота: 50.00" />

            <TextView
                android:id="@+id/textSundayBonus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile_bonus"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Доплата неділя: 60.00" />

            <TextView
                android:id="@+id/textHolidayBonus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_stat_tile_bonus"
                android:minHeight="92dp"
                android:padding="16dp"
                style="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Доплата свята: 30.00" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
