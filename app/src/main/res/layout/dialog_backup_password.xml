<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/TextAppearance.Material3.TitleLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/backup_password_title" />

    <TextView
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/backup_password_hint"
        android:textColor="@color/chart_axis_text" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBackupPassword"
        style="@style/Widget.WorkTracker.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/backup_password">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editBackupPassword"
            style="@style/Widget.WorkTracker.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBackupPasswordConfirm"
        style="@style/Widget.WorkTracker.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/backup_password_confirm">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editBackupPasswordConfirm"
            style="@style/Widget.WorkTracker.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
