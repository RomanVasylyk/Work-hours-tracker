<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.InvoiceArchiveFragment">

    <LinearLayout
        android:id="@+id/invoiceArchiveContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchInvoiceFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/invoice_filters_toggle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutInvoiceSearch"
            style="@style/Widget.WorkTracker.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/invoice_filter_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editInvoiceSearch"
                style="@style/Widget.WorkTracker.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layoutInvoiceFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutInvoiceFilterRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutInvoiceYear"
                    style="@style/Widget.WorkTracker.TextInputLayout.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/invoice_filter_year">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputInvoiceYear"
                        style="@style/Widget.WorkTracker.DropdownInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutInvoiceMonth"
                    style="@style/Widget.WorkTracker.TextInputLayout.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/invoice_filter_month">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputInvoiceMonth"
                        style="@style/Widget.WorkTracker.DropdownInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutInvoiceFilterRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutInvoiceClient"
                    style="@style/Widget.WorkTracker.TextInputLayout.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/invoice_filter_client">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputInvoiceClient"
                        style="@style/Widget.WorkTracker.DropdownInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutInvoiceStatus"
                    style="@style/Widget.WorkTracker.TextInputLayout.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/invoice_filter_status">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputInvoiceStatus"
                        style="@style/Widget.WorkTracker.DropdownInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textEmptyInvoices"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/invoice_archive_empty"
            android:textColor="@color/chart_axis_text"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerInvoices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_invoice_record" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
